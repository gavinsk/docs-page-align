{
  "manifest_version": 3,
  "name": "Docs Page Align",
  "version": "1.0.0",
  "description": "Moves the Google Docs page to the left or right side of the window, leaving blank space for annotating.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Docs Page Align",
    "default_popup": "popup.html"
  }
}
